# --- Database ---
# Neon / Vercel Postgres (provider = postgresql):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Auth.js / sessions (required) ---
# openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# App URL — local and production
AUTH_URL="http://localhost:3000"
# NEXTAUTH_URL is also accepted by Auth.js
# NEXTAUTH_URL="http://localhost:3000"

# --- Social login (optional — email/password always works) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# X (Twitter) OAuth 2.0
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- GoCardless Bank Account Data (UK/EU) — primary bank sync ---
# Free user secrets: https://bankaccountdata.gocardless.com/
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# Must match the redirect you use after bank authorisation
GOCARDLESS_REDIRECT_URI="http://localhost:3000/api/gocardless/callback"
# Production example:
# GOCARDLESS_REDIRECT_URI="https://YOUR_DOMAIN/api/gocardless/callback"
# If unset, redirect is derived as AUTH_URL + /api/gocardless/callback

# Optional alternative (not wired as primary): Plaid EU
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
