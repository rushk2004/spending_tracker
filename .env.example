# --- Database ---
# Neon / Vercel Postgres (provider = postgresql):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Auth.js / sessions (required) ---
# openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# App URL — local and production
AUTH_URL="http://localhost:3000"
# NEXTAUTH_URL is also accepted by Auth.js
# NEXTAUTH_URL="http://localhost:3000"

# --- Social login (optional — email/password always works) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# X (Twitter) OAuth 2.0
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- TrueLayer Open Banking (UK/EU) — primary bank sync ---
# Get live Client ID / Secret from https://console.truelayer.com/
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
# Live is the default for production banks (Revolut, Monzo, Starling, etc.)
TRUELAYER_ENV=live
# Must match a redirect URI registered in TrueLayer console (exact match)
TRUELAYER_REDIRECT_URI="http://localhost:3000/api/truelayer/callback"
# Production example:
# TRUELAYER_REDIRECT_URI="https://YOUR_DOMAIN/api/truelayer/callback"
#
# Advanced / local TrueLayer sandbox only (mock providers in console):
# TRUELAYER_ENV=sandbox

# Optional alternative (not wired as primary): Plaid EU
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
