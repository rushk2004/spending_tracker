# --- Database ---
# SQLite for local development (path relative to prisma/)
# Local SQLite example (change prisma provider to sqlite if using this):
# DATABASE_URL="file:./dev.db"
# Neon / Vercel Postgres (current default provider = postgresql):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Auth.js / sessions (required) ---
# openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# App URL — local and Vercel
AUTH_URL="http://localhost:3000"
# NEXTAUTH_URL is also accepted by Auth.js
# NEXTAUTH_URL="http://localhost:3000"

# --- Social login (optional — email/password always works) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# X (Twitter) OAuth 2.0
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Auth.js alternate names also supported for Twitter:
# AUTH_TWITTER_ID=
# AUTH_TWITTER_SECRET=

# --- TrueLayer Open Banking (UK/EU) — primary bank sync ---
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_ENV=sandbox
# Must match a redirect URI registered in TrueLayer console
TRUELAYER_REDIRECT_URI="http://localhost:3000/api/truelayer/callback"
# Production example:
# TRUELAYER_ENV=live
# TRUELAYER_REDIRECT_URI="https://YOUR_DOMAIN/api/truelayer/callback"

# Optional alternative (not wired as primary): Plaid EU
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
